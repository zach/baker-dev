; What "good" means for a Stuntline track (game-stacks.md §4.5). Objectives are reviewed by a
; person (§9): an agent proposes changes to this file by pull request, never with the data
; it judges.
(objective track.valid
   (desc "Every piece's connector matches the piece before it")
   (measure {track.valid})
   (pass {$value == 1}))
(objective track.pro_finishes
   (desc "The pro finishes within one and a half times par")
   (measure {track.finish_time pro})
   (pass {and {0 < $value} {$value <= {1.5 * {track.par}}}}))
(objective track.pro_crashes
   (desc "The pro crashes at most once in ten pieces")
   (measure {track.crash_rate pro})
   (pass {$value <= 0.1}))
(objective track.airtime
   (desc "Air, but not a flight: the pro spends 3% to 25% of the race off the ground")
   (measure {track.airtime_share pro})
   (pass {0.03 <= $value <= 0.25}))
(objective track.skill_spread
   (desc "Skill pays, but a rookie still gets round: rookie over ace time, 1.05 to 1.6")
   (measure {track.skill_spread})
   (pass {1.05 <= $value <= 1.6}))
(objective track.jumps_need_commitment
   (desc "Every jump is cleared at the pro's speed, and would not be at 70% of it")
   (measure {track.jump_commitment})
   (pass {$value == 1}))
(objective track.played_finishes
   (desc "Driven on the game's own steps, the car finishes")
   (measure {track.finished})
   (pass {$value == 1}))
