; Duel's data: the rules, the fighters and their frame data, the CPU's difficulties, and the
; bots the simulation plays it against. Edit and save while it runs: the next frame fights
; with the change. Tuning of your own goes in local.dta (not checked in).
;
; Here the shape of a fighter, a CPU level and a bot is written at its table, with no
; (at ...) to restate the place and no (keyed) to forget: each governs the children of the
; array it is written in. The pack keeps the move shape, whose (at fighters * moves) spans
; every fighter's moves, which no one table can say.
#require "../packs/game/duel_core.dta"

(duel
   (hit_pause 6 (range 0 30) (desc "Frames both fighters freeze on contact: the weight of a hit"))
   (buffer 5 (range 1 20) (desc "Frames a press waits for its fighter to be able to act"))
   (stun_decay 1 (range 0 10) (desc "Hitstun each hit of a combo loses, in frames"))
   (stage_half_width 4 (range 2 20) (desc "Metres from the center to a wall"))
   (start_gap 2 (range 0.5 10) (desc "Metres between the fighters at a round's start"))
   (round_seconds 60 (range 5 600))
   (ko_frames 90 (range 1 600) (desc "Frames from a knockout to the next round"))
   (show_boxes 1))

(fighters
   #shape (fighter
      (health        int   (range 1 100000))
      (width         float (range 0.2 3) (kind meters))
      (height        float (range 0.5 4) (kind meters))
      (crouch_height float (range 0.3 4) (kind meters))
      (walk_forward  float (range 0 20) (desc "Metres per second"))
      (walk_back     float (range 0 20) (desc "Metres per second"))
      (moves         any))
   (kestrel
      (health 1000) (width 0.6) (height 1.8) (crouch_height 1.1)
      (walk_forward 2.4) (walk_back 1.8)
      (moves
         (jab       (button light) (startup 4) (active 2) (recovery 7) (damage 30)
                    (hitstun 12) (blockstun 9) (push 0.12) (cancels jab low_kick)
                    (hitbox 0.3 1.3 0.55 0.2))
         (low_kick  (button kick) (crouching 1) (startup 6) (active 3) (recovery 12)
                    (damage 45) (hitstun 16) (blockstun 10) (push 0.15) (guard low)
                    (cancels palm) (hitbox 0.3 0.1 0.6 0.25))
         (side_kick (button kick) (startup 7) (active 3) (recovery 14) (damage 60)
                    (hitstun 17) (blockstun 11) (push 0.2) (hitbox 0.35 0.9 0.75 0.25))
         (heavy     (button heavy) (startup 9) (active 3) (recovery 18) (damage 90)
                    (hitstun 20) (blockstun 14) (push 0.25) (cancels palm)
                    (hitbox 0.35 1.1 0.7 0.3))
         (palm      (button special) (startup 12) (active 4) (recovery 24) (damage 120)
                    (hitstun 30) (blockstun 12) (push 0.6) (hitbox 0.2 0.8 0.8 0.8)))))

; The CPU: each difficulty is how fast it sees, how often it guards, punishes, and attacks.
; Guarding, it stands, and crouches for a low only once it sees one: a reaction under about
; 10 frames is faster than a person can react to a move (metrics/duel.dta).
(cpu
   #shape (cpu_level
      (reaction     int (range 0 63) (kind frames) (desc "Frames before it sees a move"))
      (block        float (range 0 1) (desc "Chance, per decision near the opponent, it guards"))
      (punish       float (range 0 1) (desc "Chance it attacks a move it sees recovering"))
      (aggression   float (range 0 1) (desc "Chance, per decision, it attacks in range"))
      (combo        float (range 0 1) (desc "Chance it cancels a move that connected"))
      (mash         float (range 0 1) (optional) (desc "Chance, per frame, of a random button"))
      (approach     float (range 0 1) (desc "Chance, per decision, it walks in, not back"))
      (decide_every int (range 1 60) (kind frames)))
   (easy   (reaction 30) (block 0.2) (punish 0.1) (aggression 0.55) (combo 0.1)  (approach 0.55) (decide_every 10))
   (normal (reaction 20) (block 0.4) (punish 0.6) (aggression 0.85) (combo 0.35) (approach 0.6)  (decide_every 8))
   (hard   (reaction 12) (block 0.6) (punish 0.8) (aggression 1)    (combo 1)    (approach 0.65) (decide_every 5)))

; Scripted players for the simulation: a newcomer who mashes, a defensive player who blocks
; and punishes, and a player who knows the combos.
(bots
   #shape (bot
      (reaction     int (range 0 63) (kind frames))
      (block        float (range 0 1))
      (punish       float (range 0 1))
      (aggression   float (range 0 1))
      (combo        float (range 0 1))
      (mash         float (range 0 1) (optional))
      (approach     float (range 0 1))
      (decide_every int (range 1 60) (kind frames)))
   (masher (reaction 40) (block 0)   (punish 0) (aggression 0.1) (combo 0)   (mash 0.05) (approach 0.7)  (decide_every 12))
   (turtle (reaction 10) (block 0.9) (punish 1)   (aggression 0.5) (combo 0.8) (approach 0.35) (decide_every 8))
   (combo  (reaction 18) (block 0.4) (punish 0.5) (aggression 0.6) (combo 1) (approach 0.75) (decide_every 6)))
