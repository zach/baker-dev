; The cube's data: every value the game reads. Edit and save while it runs; the corner
; shows how long the change took to appear. Tuning of your own goes in local.dta (not
; checked in), which the game layers over this file.
(cube
   (spin 45 (@range -720 720) (@step 5) (@desc "Degrees per second"))
   (size 1 (@range 0.1 5) (@step 0.1) (@desc "Edge, in meters"))
   (color 0.9 0.5 0.2 (@range 0 1) (@desc "Cube color"))
   (tilt 20 (@range -90 90) (@desc "Degrees about x")))

(camera
   (distance 4 (@range 1 50) (@desc "Meters from the cube"))
   (height 1.5 (@range -20 20) (@desc "Meters above it")))

(scene
   (clear 0.1 0.1 0.12 (@range 0 1) (@desc "Background color")))
