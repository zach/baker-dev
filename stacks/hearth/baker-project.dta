; What this stack's Config is made of: the game reads it (base::Live), and so do tools that
; open the stack, such as an editor or a checker (Baker's read_project).
(project
   (pack_levels engine game task)
   (include_dirs "data")
   (reference "build/reference.json")   ; written by the build (stacks_reference)
   (build "../../build-stacks")         ; the README's; a tool may name its own
   (tool "$build/bin/stacks_hearth")    ; the game: it answers check, sim, ...
   (scenarios "sim")                    ; what `sim` runs (agent.md)
   (objectives "metrics")               ; what it judges them by
   (console 4559)                       ; the console's port, unless --console-port names one
   (format (indent 3) (width 100))      ; how its files are laid out (format)
   (layers
      (default "data/default.dta")
      (local "data/local.dta" optional dev_only)   ; one developer's own tuning; sim and check skip it
      (agent "data/agent.dta" optional dev_only)))
