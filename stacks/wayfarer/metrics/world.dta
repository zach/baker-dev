; What "exploring leads somewhere" means for Wayfarer (game-stacks.md §4.4). Objectives are
; reviewed by a person (§9): an agent proposes changes to this file by pull request, never
; with the data it judges.
(objective wayfarer.no_softlocks
   (desc "No save point from which a mission can no longer be finished")
   (measure {world.softlocks})
   (pass {$value == 0}))
(objective wayfarer.objectives_reachable
   (desc "Every objective can be done, by some route")
   (measure {world.unreachable})
   (pass {$value == 0}))
(objective wayfarer.points_reachable
   (desc "Every point of interest can be got to, by some route")
   (measure {world.unreachable_pois})
   (pass {$value == 0}))
(objective wayfarer.goals_readable
   (desc "Every goal is one the proof can read (at_poi, flag, has_item, mission.done)")
   (measure {world.unanalysed})
   (pass {$value == 0}))
(objective wayfarer.glides_make_it
   (desc "Every glide clears with 10% to spare")
   (measure {world.glide_margin})
   (pass {$value >= 1.1}))
(objective wayfarer.no_dead_zone
   (desc "No stretch of more than 90 seconds without finding something")
   (measure {world.pacing_gap})
   (pass {$value <= 90}))
(objective wayfarer.missions_on_time
   (desc "Following the objectives, every mission is done within 5 minutes")
   (measure {world.pacing_done})
   (pass {0 <= $value <= 300}))
(objective wayfarer.finds_everything
   (desc "The bot finds every point of interest")
   (measure {world.pacing_missed})
   (pass {$value == 0}))
(objective wayfarer.played_arrives
   (desc "On the game's own steps, the character gets where the analyses' path goes")
   (measure {world.arrived})
   (pass {$value == 1}))
(objective wayfarer.played_at_lighthouse
   (desc "...which, after the harbor, is the lighthouse on its cliff: a climb")
   (measure {at_poi lighthouse})
   (pass {$value == 1}))
(objective wayfarer.played_at_garden
   (desc "...which, from the eyrie, is the sky garden: a glide")
   (measure {at_poi sky_garden})
   (pass {$value == 1}))
(objective wayfarer.played_streams
   (desc "Walking from one end of the world to the other, never all nine cells built at once")
   (measure {world.cells_peak})
   (pass {$value < 9}))
