; What "good" means for Duel (game-stacks.md §4.6). Objectives are reviewed by a person
; (§9): an agent proposes changes to this file by pull request, never with the data it judges.

; The frame data.
(objective duel.no_infinites
   (desc "No combo goes on forever")
   (measure {duel.infinites})
   (pass {== $value 0}))
(objective duel.combo_ceiling
   (desc "No combo does more than 35% of a fighter's health")
   (measure {duel.max_combo_damage})
   (pass {<= $value 350}))
(objective duel.block_advantage
   (desc "No move is more than 2 frames ahead on block: blocking must give the turn back")
   (measure {duel.max_block_advantage})
   (pass {<= $value 2}))

; The CPU is fair: it never reacts faster than a person could.
(objective duel.reaction_floor
   (desc "The CPU never blocks an attack within 10 frames of its start")
   (measure {duel.fastest_reaction 2})
   (pass {or {< $value 0} {>= $value 10}}))

; The CPU is beatable and teaches: its share of rounds against each kind of player, per
; difficulty, is the designer's curve.
(objective duel.easy_vs_masher
   (desc "Easy: a newcomer mashing wins about half the time")
   (measure {duel.win_rate 2})
   (pass {and {>= $value 0.3} {<= $value 0.7}}))
(objective duel.normal_vs_masher
   (desc "Normal: mashing mostly loses")
   (measure {duel.win_rate 2})
   (pass {and {>= $value 0.6} {<= $value 0.95}}))
(objective duel.hard_vs_masher
   (desc "Hard: mashing does not work")
   (measure {duel.win_rate 2})
   (pass {>= $value 0.85}))
(objective duel.easy_vs_combo
   (desc "Easy: a player who knows the combos wins nearly always")
   (measure {duel.win_rate 2})
   (pass {<= $value 0.25}))
(objective duel.normal_vs_combo
   (desc "Normal: a player who knows the combos wins most rounds")
   (measure {duel.win_rate 2})
   (pass {and {>= $value 0.15} {<= $value 0.5}}))
(objective duel.hard_vs_combo
   (desc "Hard: an even fight for a player who knows the combos, and still beatable")
   (measure {duel.win_rate 2})
   (pass {and {>= $value 0.35} {<= $value 0.75}}))
(objective duel.normal_vs_turtle
   (desc "Normal: blocking alone does not beat the CPU, but it takes rounds from it")
   (measure {duel.win_rate 2})
   (pass {and {>= $value 0.4} {<= $value 0.9}}))
