; The moves table: its shape, marked (@view), is what the build generates game::Move from.
#shape (move (@at fighters * moves) (@keyed) (@view)
   (startup     int (@range 1 60) (@kind frames) (@desc "Frames before the hit lands"))
   (damage      float (@range 0 200))
   (button      symbol (@one_of light heavy kick) (@optional))
   (cancel_into (list (key_of moves)) (@optional) (@desc "Moves this one may cancel into"))
   (on_hit      any (@optional) (@view no) (@desc "A command that runs when it lands")))

(fighters
   (kestrel (moves
      (jab   (startup 4) (damage 3.5) (button light) (cancel_into heavy kick))
      (heavy (startup 9) (damage 12) (button heavy) (on_hit {stagger 0.3}))
      (kick  (startup 7) (damage 8) (button kick)))))
