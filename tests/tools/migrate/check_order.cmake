# Runs the two migrations over SOURCE in both orders, into WORK, and fails unless the texts
# match and the metadata inside the shape has its sigil (D270).
foreach(order "DECL;META" "META;DECL")
  string(REPLACE ";" "_" name "${order}")
  set(text "${SOURCE}")
  foreach(step ${order})
    set(out "${WORK}/${name}_${step}.dta")
    execute_process(COMMAND "${${step}}" "${text}" OUTPUT_FILE "${out}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "${${step}} ${text}: exit ${rc}")
    endif()
    set(text "${out}")
  endforeach()
  file(READ "${text}" result_${name})
endforeach()
if(NOT result_DECL_META STREQUAL result_META_DECL)
  message(FATAL_ERROR "the orders differ:\n${result_DECL_META}\n---\n${result_META_DECL}")
endif()
foreach(want "#shape (enemy (@at" "(@desc \"One enemy.\")" "(taunt string (@optional))")
  string(FIND "${result_DECL_META}" "${want}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "missing ${want}:\n${result_DECL_META}")
  endif()
endforeach()
