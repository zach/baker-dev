# Runs baker_migrate (MIGRATE) over SOURCE three ways, into WORK: one migration then the other,
# in both orders, and both in one pass. Fails unless the three texts match and the metadata
# inside the shape has its sigil (D274, D276).
foreach(order "declarations;metadata" "metadata;declarations" "")
  string(REPLACE ";" "_" name "_${order}")
  set(text "${SOURCE}")
  set(steps ${order})
  if(NOT steps)
    set(steps "all")
  endif()
  foreach(step ${steps})
    set(out "${WORK}/migrate${name}_${step}.dta")
    if(step STREQUAL "all")
      set(only "")
    else()
      set(only --only ${step})
    endif()
    execute_process(COMMAND "${MIGRATE}" ${only} "${text}" OUTPUT_FILE "${out}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "${MIGRATE} ${only} ${text}: exit ${rc}")
    endif()
    set(text "${out}")
  endforeach()
  file(READ "${text}" result${name})
endforeach()
if(NOT result_declarations_metadata STREQUAL result_metadata_declarations OR
   NOT result_declarations_metadata STREQUAL result_)
  message(FATAL_ERROR "the orders differ:\n${result_declarations_metadata}\n---\n"
                      "${result_metadata_declarations}\n---\n${result_}")
endif()
foreach(want "#shape (enemy (@at" "(@desc \"One enemy.\")" "(taunt string (@optional))")
  string(FIND "${result_}" "${want}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "missing ${want}:\n${result_}")
  endif()
endforeach()
